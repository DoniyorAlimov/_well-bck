# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

DATABASE_URL="sqlserver://localhost:1433;database=well-bck;integratedSecurity=true;trustServerCertificate=true;"

# Signs the express-session cookie (see middlewares/session.ts). Dev-only
# value below — use a real random secret in any deployed environment, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-session-secret-change-me"

# TLS, production only (`npm start`, which sets NODE_ENV=production) — not
# env configurable. `npm run dev` always serves plain HTTP. The active cert
# is always cert/active.pfx, with its DPAPI-protected passphrase in the
# sidecar file cert/active.pfx.passphrase (both git-ignored).
# Bootstrap: `npm run setup:tls-cert` (as Administrator) — provisions a
# self-signed cert in Cert:\LocalMachine\My and exports it, see
# scripts/setup-tls-cert.ps1. Later replaced with a CA-issued cert via
# Admin Console -> TLS Certificate (routes/adminTlsCert.ts), no elevation
# needed for that path.
