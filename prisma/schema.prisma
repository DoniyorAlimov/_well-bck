// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model UtilityType {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(255)
  description String? @db.VarChar(255)

  assets         Asset[]
  attributeTypes AttributeType[]
}

model Asset {
  id            Int    @id @default(autoincrement())
  name          String @unique @db.VarChar(255)
  parentAssetId Int?
  utilityTypeId Int

  target      Target?
  attributes  Attribute[]
  parentAsset Asset?      @relation("Assets", fields: [parentAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  utilityType UtilityType @relation(fields: [utilityTypeId], references: [id])
  children    Asset[]     @relation("Assets")
}

model Target {
  id                              Int     @id @default(autoincrement())
  productionTarget                Decimal
  energyConsumptionTarget         Decimal
  specificEnergyConsupmtionTarget Decimal
  CO2EmissionTarget               Decimal
  assetId                         Int     @unique

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model AttributeType {
  id            Int    @id @default(autoincrement())
  name          String @db.VarChar(255)
  description   String @db.VarChar(255)
  unitId        Int?
  utilityTypeId Int

  attributes  Attribute[]
  utilityType UtilityType @relation(fields: [utilityTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Each asset type owns its own attribute definitions — two types can have
  // an attribute with the same display name, but they're separate rows.
  @@unique([name, utilityTypeId])
}

model Attribute {
  id              Int    @id @default(autoincrement())
  name            String @db.VarChar(255)
  assetId         Int
  attributeTypeId Int

  attributeType AttributeType @relation(fields: [attributeTypeId], references: [id])
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assignments   Assignment[]
}

model Unit {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(255)
  description String? @db.VarChar(255)

  PHDTags PHDTag[]
}

model PHDTag {
  id      Int    @id @default(autoincrement())
  tagname String @unique @db.VarChar(300)
  unitId  Int

  unit        Unit         @relation(fields: [unitId], references: [id])
  records     Record[]
  assignments Assignment[]
}

model Assignment {
  attributeId Int
  PHDTagId    Int

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  PHDTag    PHDTag    @relation(fields: [PHDTagId], references: [id])

  @@id([attributeId, PHDTagId])
}

model Record {
  id        Int      @id @default(autoincrement())
  value     Decimal
  PHDTagId  Int
  timestamp DateTime

  PHDTag PHDTag @relation(fields: [PHDTagId], references: [id], onDelete: Cascade)
}

model Constant {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(255)
  value Decimal
}

model DataSource {
  id   Int    @id @default(autoincrement())
  host String @db.VarChar(300)
  port Int
}

model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique @db.VarChar(50)
  domainUsername String?  @unique @db.VarChar(255)
  isAdmin        Boolean  @default(false) @db.Bit
  joined_at      DateTime @default(now()) @db.DateTime
}

// SQL Server has no native TTL/expiring-collection feature, so expired rows
// are removed by an app-level sweep (see lib/prismaSessionStore.ts), not the DB.
// data is NVarChar(Max), not a bounded width, because useGroups:true on the
// SSO middleware can put a large AD group list into the session payload.
model Session {
  sid       String   @id
  data      String   @db.NVarChar(Max)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}
